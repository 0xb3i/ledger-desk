{
  "name": "ledgerdesk",
  "version": "0.14.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8787",
    "build": "tsc --noEmit && vite build",
    "build:local": "npm run build && node scripts/build-local.mjs",
    "install:local": "npm run build:local && node scripts/install-local.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "preview": "wrangler dev --port 8787",
    "deploy": "node scripts/deploy.mjs",
    "setup:local": "npm run install:local",
    "test:shortcut": "python3 -m unittest discover -s tests -p \"shortcut*.py\"",
    "dev:server": "node scripts/dev-server.mjs"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "4.13.16",
    "lucide-react": "1.66.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "recharts": "^3.11.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261101.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "miniflare": "4.20260730.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.156.0"
  }
}
